{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mei-portal.local/manifest.schema.json",
  "title": "mei-portal 插件清单",
  "description": "描述一个被整合的子应用。Shell 构建期扫描 plugins/*/manifest.yml 聚合为 public/__theme/plugins.json。",
  "type": "object",
  "required": ["id", "name", "icon", "category", "path", "endpoint"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,30}$",
      "description": "唯一标识，与目录名一致，用于主题 CSS 文件名与运行时应用注册表"
    },
    "name": { "type": "string", "description": "展示名（中文）" },
    "description": { "type": "string", "description": "一句话说明" },
    "icon": {
      "type": "string",
      "description": "iconify 图标标识，如 lucide:tv 或 mdi:movie"
    },
    "category": {
      "type": "string",
      "enum": ["media", "utility", "network", "game", "productivity", "other"],
      "description": "分组类别"
    },
    "weight": {
      "type": "integer",
      "default": 50,
      "description": "同组内排序权重，越小越靠前"
    },
    "path": {
      "type": "string",
      "pattern": "^/[a-z0-9][a-z0-9-]*$",
      "description": "单镜像下的 URL 子路径（nginx location 前缀），如 /tv、/novels"
    },
    "endpoint": {
      "type": "string",
      "description": "健康探活的目标地址（http://<service>:<port>）；单镜像运行时由 image/plugins.json 覆盖为同源相对路径"
    },
    "embed": {
      "type": "object",
      "properties": {
        "iframe": { "type": "boolean", "default": true },
        "strip_headers": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["X-Frame-Options", "Content-Security-Policy"],
          "description": "nginx 需剥离的响应头，便于 iframe 嵌入"
        }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "has_skin": {
          "type": "boolean",
          "default": false,
          "description": "是否提供协调 CSS（plugins/<id>/theme.css）"
        },
        "entry": {
          "type": "string",
          "description": "协调 CSS 的加载路径，通常 /__theme/<id>.css"
        }
      }
    },
    "health": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "default": "/" },
        "expect": { "type": "integer", "default": 200 }
      }
    }
  }
}

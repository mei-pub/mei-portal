# =============================================================================
# mei-portal 单镜像部署环境变量示例
# 复制为 .env 后按需修改；全部变量有默认值，不建 .env 也能直接跑。
# =============================================================================

# ----- 统一管理员凭据（单用户）-----
# 仅在 /data/shell/user.json 不存在时的首次初始化生效；
# 之后请登录门户在设置里改密码（改环境变量不会再生效）。
MEI_ADMIN_USER=admin
MEI_ADMIN_PASSWORD=mei-allin

# ----- 可选：音乐 YouTube 源 PO Token -----
# bgutil 服务自动获取，异常时手工覆盖
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=

# ----- 时区 -----
TZ=Asia/Shanghai

# =============================================================================
# mei-allin 环境变量示例
# 复制为 .env 并按需修改。所有变量都有合理默认值，开箱即用。
# =============================================================================

# ----- 网关域名 -----
# 根域名。Shell 跑在 ROOT_DOMAIN，各应用跑在 <prefix>.ROOT_DOMAIN
# 默认用 nip.io 免配置泛解析：运行 scripts/setup-ip.sh 会自动填充
# 例：allin.local  或  allin.192-168-1-10.nip.io
ROOT_DOMAIN=allin.local

# 是否启用 HTTPS（内网默认关闭）。true 时需先运行 scripts/setup-certs.sh
USE_TLS=false

# ----- Shell 入口门禁 -----
# 访问门户所需的简单密码（留空则完全开放）
SHELL_PASSWORD=mei-allin

# ----- 公共卷根目录 -----
# 各应用持久化数据统一存放在这里
DATA_ROOT=./data

# ----- 各应用子域名前缀（改前缀需同步改 nginx conf.d/<id>.conf 的 server_name）-----
SUBDOMAIN_PANEL=panel
SUBDOMAIN_DRAW=draw
SUBDOMAIN_MEDIA=media
SUBDOMAIN_TV=tv
SUBDOMAIN_MUSIC=music
SUBDOMAIN_TOOLS=tools
SUBDOMAIN_LINK=link
SUBDOMAIN_NOVELS=novels

# ----- 应用专属配置（按需开启，全部有镜像默认值）-----
# LunaTV
LUNATV_USERNAME=admin
LUNATV_PASSWORD=admin123

# Solara 音乐站（留空=开放访问）
SOLARA_PASSWORD=

# mei-link 内网穿透
MEILINK_ADMIN_USER=admin
MEILINK_ADMIN_PASSWORD=meilink123

# 时区
TZ=Asia/Shanghai

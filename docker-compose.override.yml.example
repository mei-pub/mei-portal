# =============================================================================
# docker-compose 覆盖示例（单镜像架构）
# 复制为 docker-compose.override.yml 后按需启用。docker compose 会自动合并。
# 常见用途：调整端口映射、挂载宿主字体、注入环境变量。
# =============================================================================

# 示例 1：换端口映射（宿主 8080 → 容器 7777）
# services:
#   mei-allin:
#     ports: ["8080:7777"]

# 示例 2：为小说站挂载宿主字体目录（免容器内后台下载 Google Fonts）
# services:
#   mei-allin:
#     volumes:
#       - mei-data:/data
#       - ./my-fonts:/data/tutorial/fonts/files:ro

# 示例 3：覆盖管理员凭据（仅首次初始化 /data/shell/user.json 时生效）
# services:
#   mei-allin:
#     environment:
#       MEI_ADMIN_USER: admin
#       MEI_ADMIN_PASSWORD: "your-password"
